# rwa-backend local development: `cp .env.example .env`, put the two API keys in, never commit .env.
# Every `go run ./cmd/rwa ...` started in rwa-backend/ reads ./.env (or $ENV_FILE); real environment variables win.
# Defaults below suit the dev database from `make dev-db` (PostgreSQL 16 on 127.0.0.1:5433, rwa/rwa/rwa).

# --- required ---------------------------------------------------------------------------------------------------
DATABASE_URL=postgres://rwa:rwa@127.0.0.1:5433/rwa?sslmode=disable

# Needed only by commands that call the sources: collector, run-once, probe. api, migrate, import-v1, build and
# publish work without them. Portals key without the "Bearer " prefix.
CMC_API_KEY=
PORTALS_API_KEY=

# Paths are relative to rwa-backend/ (the Docker image uses /config/... by default).
ASSETS_PATH=config/assets.json
SETTINGS_PATH=config/settings.json

# --- API (`rwa api`) --------------------------------------------------------------------------------------------
HTTP_ADDR=127.0.0.1:8080
# Allowed browser origins, comma-separated. Not needed with `pnpm start` (Vite proxies /api and /logos).
# CORS_ORIGINS=http://localhost:3000
# Enables POST/GET /api/v1/admin/runs (manual run requests). Any long random string locally.
ADMIN_TOKEN=devtoken

# --- collector (`rwa collector`) --------------------------------------------------------------------------------
# false: do not start a live run when the collector starts (a full run costs about 22 CMC credits and 7-14 minutes).
COLLECT_ON_START=false
# Schedule: cron in UTC, or an interval (set only one of them).
COLLECT_CRON=0 6 * * *
# COLLECT_INTERVAL=24h
# RUN_TIMEOUT=2h
# MIGRATE_ON_START=true
# SNAPSHOT_RETENTION_DAYS=90
# RAW_CAPTURE_DIR=data/raw        # keep raw API responses for debugging (git-ignored only if you choose such a path)

# --- logs and the run journal (/updates/:id) --------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=text
# debug also stores every HTTP request of a run in the journal; info stores steps and per-asset results.
RUN_EVENTS_LEVEL=debug
# RUN_EVENTS_RETENTION_DAYS=30
