# rwa.cp0x.com: goes inside the existing server block of the site (its `location /` points at 127.0.0.1:3301, the
# container cp0x-pi-rwa-interface). The browser reads the API through the site (same origin, no CORS); programs and
# agents are given rwa-api.cp0x.com (rwa-api.cp0x.com.conf), which reaches the same API container.
# Apply: sudo nginx -t && sudo systemctl reload nginx

# Admin operations are never public (the site's server would forward them too, nginx answers first).
location ^~ /api/v1/admin/ { return 404; }

location /api/ {
    proxy_pass http://127.0.0.1:3302;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 30s;
}

location /logos/ {
    proxy_pass http://127.0.0.1:3302;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /healthz { proxy_pass http://127.0.0.1:3301; access_log off; }

# Links from articles to the 1.x static file: 302 while a rollback to 1.x is possible, then 301.
location = /data/rwa.json { return 302 /api/v1/export; }
