# Docker compose of the repository root (docker-compose.yml), locally and on the server. Copy to .env; .env is
# git-ignored, never commit it.
# Not used by rwa-backend (go run) or rwa-interface: they have their own .env files.

# Required by the collector
CMC_API_KEY=
PORTALS_API_KEY=

# Required by the api: token of the admin endpoints. devtoken is for localhost only; on a server use a long random value
# (openssl rand -hex 32), anyone who knows it can start runs that spend CMC credits.
ADMIN_TOKEN=devtoken

# Server (optional locally)
# RWA_VERSION=latest         # tag of cp0x/pi-rwa-backend and cp0x/pi-rwa-interface to pull (e.g. 2.0.0)
# SITE_URL=https://rwa.cp0x.com   # public address of the site: canonical links, sitemap.xml, llms.txt (default https://rwa.cp0x.com;
#                                  # http://localhost:3301 only to follow the sitemap links locally)
# PUBLIC_URL=https://rwa.cp0x.com # shown in the api startup banner only
# POSTGRES_PASSWORD=         # database password (default rwa); set before the first start, it is fixed at init

# Optional
# COLLECT_INTERVAL=24h       # collection period; the first run starts at once when the data is older
# COLLECT_ON_START=true      # false: do not collect on start (a live run costs about 22 CMC credits)
# LOG_LEVEL=info             # debug | info | warn | error
# PGDATA_DIR=./pg-data       # folder with the PostgreSQL files of this stack (git-ignored by default)
# WEB_PORT=3301              # host port of the site (default 3301)
# API_PORT=3302              # host port of the API (default 3302; the local `go run` API uses 8080, so both modes can run)
