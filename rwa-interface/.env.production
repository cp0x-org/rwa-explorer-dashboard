VITE_APP_VERSION=v2.0.0

VITE_APP_BASE_NAME=/

# public address of the site: canonical links, sitemap.xml and robots.txt used by the server render (SITE_URL of server/ overrides it at runtime)
VITE_SITE_URL=https://rwa.cp0x.com

# public address of the API for programs and agents: llms.txt, JSON-LD, the API links in <head> (API_PUBLIC_URL of server/
# overrides it at runtime). The browser still calls the site's own /api/.
VITE_API_PUBLIC_URL=https://rwa-api.cp0x.com
