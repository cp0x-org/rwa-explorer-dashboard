# rwa-interface: optional. `pnpm start` works without any .env file (defaults below).
# To change something: `cp .env.example .env.local` (git-ignored); Vite reads .env.local for `pnpm start` and builds.
# .env.production (tracked) holds the values baked into production builds.

# Version chip shown in the sidebar.
VITE_APP_VERSION=v2.0.0-dev
VITE_APP_BASE_NAME=/

# Where `pnpm start` proxies /api and /logos. Default http://localhost:8080 = `go run ./cmd/rwa api` or `pnpm mock:api`.
# VITE_API_URL=http://localhost:8080

# Public address used in canonical links and the sitemap (the SSR server's SITE_URL overrides it at runtime).
# VITE_SITE_URL=http://localhost:4173

# The SSR server (`pnpm serve`, server/index.mjs) does not read .env files. It takes plain environment variables,
# and its defaults fit a local run:
#   API_URL=http://127.0.0.1:8080   PORT=4173   SITE_URL=(VITE_SITE_URL of the build)
# Example: API_URL=http://127.0.0.1:8080 SITE_URL=http://localhost:4173 pnpm serve
